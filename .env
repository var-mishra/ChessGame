# Global project settings
PROJECT_NAME=cdc-pipeline

# MySQL
MYSQL_ROOT_PASSWORD=example
MYSQL_DATABASE=inventory
MYSQL_USER=app
MYSQL_PASSWORD=app
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium

# Kafka
KAFKA_HOST_PORT=9094

# NiFi
NIFI_HOST_PORT=8090

# ClickHouse
